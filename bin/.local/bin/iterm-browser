#!/usr/bin/env bash
# Open a file or URL in iTerm2's built-in browser (iTermBrowserPlugin) using the
# OSC 1337 OpenURL escape sequence. Works inside tmux (needs `allow-passthrough
# on`). A local path is resolved to an absolute, percent-encoded file:// URL.
#
#   iterm-browser ~/docs/paper.pdf
#   iterm-browser https://example.com
set -euo pipefail

if [ "$#" -lt 1 ] || [ -z "${1:-}" ]; then
  echo "usage: ${0##*/} <file|url>" >&2
  exit 1
fi

arg=$1
case "$arg" in
  *://*)
    url=$arg
    ;;
  *)
    if [ ! -e "$arg" ]; then
      echo "${0##*/}: no such file: $arg" >&2
      exit 1
    fi
    abs=$(cd "$(dirname "$arg")" && printf '%s/%s' "$(pwd -P)" "$(basename "$arg")")
    enc=$(printf '%s' "$abs" | python3 -c 'import sys,urllib.parse; sys.stdout.write(urllib.parse.quote(sys.stdin.read()))')
    url="file://$enc"
    ;;
esac

# Outside iTerm2 (Ubuntu desktop, WSL): hand off to the platform opener instead
# of emitting an escape sequence nothing will handle. Over SSH from iTerm2 the
# OSC would reach iTerm2, but a remote file:// path wouldn't resolve there anyway.
if [ "${TERM_PROGRAM:-}" != "iTerm.app" ]; then
  command -v wslview >/dev/null 2>&1 && exec wslview "$arg"  # WSL (wslu)
  command -v xdg-open >/dev/null 2>&1 && exec xdg-open "$arg"
fi

b64=$(printf '%s' "$url" | base64 | tr -d '\n')

# OSC 1337 OpenURL. Inside tmux, wrap in DCS passthrough and double the inner ESC.
if [ -n "${TMUX:-}" ]; then
  printf '\033Ptmux;\033\033]1337;OpenURL=:%s\007\033\\' "$b64" > /dev/tty
else
  printf '\033]1337;OpenURL=:%s\007' "$b64" > /dev/tty
fi
