#!/usr/bin/env bash
# Reject commits where generated terminal appearance files are out of sync
# with their master, terminal/theme.toml (see terminal/generate.py).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qE '^(terminal/|kitty/|iterm2/|tmux/\.tmux/)'; then
  if ! python3 terminal/generate.py --check; then
    echo "pre-commit: terminal appearance files are stale or hand-edited." >&2
    echo "pre-commit: edit terminal/theme.toml, run python3 terminal/generate.py, re-stage." >&2
    exit 1
  fi
fi
